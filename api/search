},"4892":{"id":"/docs/crest/user-guide/dashboard-72","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"顶部左侧"},"4893":{"id":"/docs/crest/user-guide/dashboard-73","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"返回、页面名称、撤销、重做"},"4894":{"id":"/docs/crest/user-guide/dashboard-74","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"修改前先确认正在编辑正确页面"},"4895":{"id":"/docs/crest/user-guide/dashboard-75","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"顶部组件区"},"4896":{"id":"/docs/crest/user-guide/dashboard-76","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"图表、查询组件、富文本、媒体、Tab、更多、复用"},"4897":{"id":"/docs/crest/user-guide/dashboard-77","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"所有组件都从这里添加"},"4898":{"id":"/docs/crest/user-guide/dashboard-78","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"中间画布"},"4899":{"id":"/docs/crest/user-guide/dashboard-79","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"放置和排版组件"},"4900":{"id":"/docs/crest/user-guide/dashboard-80","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"拖动组件调整位置，拖边调整大小"},"4901":{"id":"/docs/crest/user-guide/dashboard-81","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"右侧配置面板"},"4902":{"id":"/docs/crest/user-guide/dashboard-82","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"配置选中组件的数据、样式和高级选项"},"4903":{"id":"/docs/crest/user-guide/dashboard-83","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"选中不同组件时内容会变化"},"4904":{"id":"/docs/crest/user-guide/dashboard-84","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"顶部右侧"},"4905":{"id":"/docs/crest/user-guide/dashboard-85","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"外部参数、批量操作、预览、保存、发布"},"4906":{"id":"/docs/crest/user-guide/dashboard-86","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"保存后再做预览和发布"},"4907":{"id":"/docs/crest/user-guide/dashboard-87","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#进入编辑器","content":"建议新建后先保存一次。保存后页面有稳定 ID，后续配置联动、跳转、外部参数时更可靠。"},"4908":{"id":"/docs/crest/user-guide/dashboard-88","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"点击顶部“图表”后，会展开图表类型面板。不同图表适合不同分析目标。"},"4909":{"id":"/docs/crest/user-guide/dashboard-89","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"图表面板里每一种图表都对应一种分析问题。首次制作仪表盘时，建议优先使用指标卡、折线图、柱状图和明细表，字段和口径熟悉后再使用双轴、漏斗、矩阵等复杂图表。"},"4910":{"id":"/docs/crest/user-guide/dashboard-90","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"第一次制作仪表盘时，可以先按“四类基础图表”练习：指标卡看当前值，折线图看趋势，柱状图看对比，表格看明细。掌握这四类组件后，大多数经营分析页面都可以完成基础搭建。"},"4911":{"id":"/docs/crest/user-guide/dashboard-91","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"常用图表选择建议："},"4912":{"id":"/docs/crest/user-guide/dashboard-92","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"图表类型"},"4913":{"id":"/docs/crest/user-guide/dashboard-93","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"适合展示"},"4914":{"id":"/docs/crest/user-guide/dashboard-94","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"典型字段"},"4915":{"id":"/docs/crest/user-guide/dashboard-95","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"指标卡"},"4916":{"id":"/docs/crest/user-guide/dashboard-96","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"核心数字、目标达成、当前状态"},"4917":{"id":"/docs/crest/user-guide/dashboard-97","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"销售额、订单数、完成率"},"4918":{"id":"/docs/crest/user-guide/dashboard-98","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"表格/明细表"},"4919":{"id":"/docs/crest/user-guide/dashboard-99","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"明细记录、排行、台账"},"4920":{"id":"/docs/crest/user-guide/dashboard-100","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"门店、客户、项目、金额"},"4921":{"id":"/docs/crest/user-guide/dashboard-101","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"折线图/面积图"},"4922":{"id":"/docs/crest/user-guide/dashboard-102","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"时间趋势"},"4923":{"id":"/docs/crest/user-guide/dashboard-103","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"日期 + 销售额、订单数"},"4924":{"id":"/docs/crest/user-guide/dashboard-104","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"柱状图/条形图"},"4925":{"id":"/docs/crest/user-guide/dashboard-105","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"分类对比、排名"},"4926":{"id":"/docs/crest/user-guide/dashboard-106","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"区域/产品 + 指标"},"4927":{"id":"/docs/crest/user-guide/dashboard-107","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"饼图/环形图"},"4928":{"id":"/docs/crest/user-guide/dashboard-108","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"占比结构"},"4929":{"id":"/docs/crest/user-guide/dashboard-109","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"分类 + 指标"},"4930":{"id":"/docs/crest/user-guide/dashboard-110","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"双轴图"},"4931":{"id":"/docs/crest/user-guide/dashboard-111","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"两个指标同趋势对比"},"4932":{"id":"/docs/crest/user-guide/dashboard-112","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加第一个图表","content":"日期 + 销售额 + 订单数"},"4933":{"id":"/docs/crest/user-guide/dashboard-113","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#选择图表类型","content":"从图表面板选择一个图表。首次配置可从指标卡、折线图、柱状图和表格开始。"},"4934":{"id":"/docs/crest/user-guide/dashboard-114","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#放到画布","content":"点击或拖拽图表到画布。放入后先调整到合适大小，再配置样式。"},"4935":{"id":"/docs/crest/user-guide/dashboard-115","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#选择数据集","content":"在右侧数据面板选择数据集。看不到数据集时，检查数据集权限和所在文件夹。"},"4936":{"id":"/docs/crest/user-guide/dashboard-116","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#拖拽字段","content":"把维度和指标拖到图表所需位置。指标卡通常只需要一个指标；趋势图需要日期维度和指标；柱状图需要分类维度和指标。"},"4937":{"id":"/docs/crest/user-guide/dashboard-117","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#刷新图表","content":"字段放好后刷新或更新图表，确认画布上能显示数据。"},"4938":{"id":"/docs/crest/user-guide/dashboard-118","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"数据正确后，再调整标题、颜色、标签、图例、坐标轴和数值格式。"},"4939":{"id":"/docs/crest/user-guide/dashboard-119","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"选择数据集时，优先选择已经通过预览和口径确认的数据集。正式页面不应直接使用临时测试数据集。"},"4940":{"id":"/docs/crest/user-guide/dashboard-120","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"数据集选择面板用于给当前图表绑定数据来源。选择前先确认数据集名称和目录，避免选到同名测试数据集。绑定后，当前图表只会显示这个数据集里的字段。"},"4941":{"id":"/docs/crest/user-guide/dashboard-121","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"选择数据集时建议看三点：名称是否是正式数据集，创建人或最近更新时间是否可信，字段是否覆盖当前图表需要的维度和指标。如果页面里多个图表共用同一个数据集，后续查询组件和联动会更容易配置。"},"4942":{"id":"/docs/crest/user-guide/dashboard-122","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"选择数据集后，右侧会展示字段。字段通常分为维度和指标。拖字段时要根据图表类型配置，文本字段不应放入指标区，金额字段不应放入维度区。"},"4943":{"id":"/docs/crest/user-guide/dashboard-123","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"字段列表中，文本、日期、组织、状态通常作为维度；金额、数量、时长、比率通常作为指标。拖拽字段前，先确认字段名称和业务口径，尤其是“订单数”“需求数”“销售额”这类核心指标。"},"4944":{"id":"/docs/crest/user-guide/dashboard-124","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"字段分类错误是常见问题。例如“项目名称”应放入维度，“需求数”应放入指标；“日期”适合放 X 轴，“负责人”适合做筛选或明细列。放字段前要先判断：这个字段用于分组，还是用于计算？"},"4945":{"id":"/docs/crest/user-guide/dashboard-125","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"下图展示了把“销售额”放入指标卡后的状态。右侧字段区出现已使用字段，画布中的组件会根据字段刷新。"},"4946":{"id":"/docs/crest/user-guide/dashboard-126","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"字段放入后，先确认图表是否正常渲染，再检查数值是否合理。指标卡没有维度时通常显示汇总值；如果数值明显过大，先检查聚合方式和数据集关联关系。"},"4947":{"id":"/docs/crest/user-guide/dashboard-127","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"图表渲染成功并不等同于配置正确。保存前至少核对一次数据集预览里的样例值，确认聚合方式和页面筛选没有把范围放大或缩小。正式页面里的核心指标，建议让业务负责人确认口径。"},"4948":{"id":"/docs/crest/user-guide/dashboard-128","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"配置完成后，再进入样式和高级配置。样式只负责“怎么显示”，不应该用样式掩盖数据口径问题。"},"4949":{"id":"/docs/crest/user-guide/dashboard-129","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"配置面板按“数据、样式、高级”逐步处理。数据页解决字段和过滤；样式页处理标题、颜色、坐标轴、标签；高级页处理联动、跳转、刷新等交互能力。"},"4950":{"id":"/docs/crest/user-guide/dashboard-130","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"配置顺序建议固定为：先数据，再样式，最后高级交互。字段未确认前，不宜投入大量时间调整颜色；字段变更后，标题、单位、图例和标签通常也需要同步调整。"},"4951":{"id":"/docs/crest/user-guide/dashboard-131","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"完成后可以回到画布查看组件效果。"},"4952":{"id":"/docs/crest/user-guide/dashboard-132","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#再调样式","content":"这张图用于确认“图表已经进入页面”。此时要看三件事：图表标题是否清楚，图表大小是否适合当前区域，右侧配置是否和画布组件对应。页面上有多个图表时，选中组件再改配置，避免改错对象。"},"4953":{"id":"/docs/crest/user-guide/dashboard-133","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"图表"},"4954":{"id":"/docs/crest/user-guide/dashboard-134","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"需要字段"},"4955":{"id":"/docs/crest/user-guide/dashboard-135","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"配置说明"},"4956":{"id":"/docs/crest/user-guide/dashboard-136","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"指标卡"},"4957":{"id":"/docs/crest/user-guide/dashboard-137","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"1 个指标，可选同比/环比字段"},"4958":{"id":"/docs/crest/user-guide/dashboard-138","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"适合页面顶部核心数字，标题要写清指标口径"},"4959":{"id":"/docs/crest/user-guide/dashboard-139","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"折线图"},"4960":{"id":"/docs/crest/user-guide/dashboard-140","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"日期维度 + 1 个或多个指标"},"4961":{"id":"/docs/crest/user-guide/dashboard-141","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"日期字段要是日期类型，避免按文本排序"},"4962":{"id":"/docs/crest/user-guide/dashboard-142","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"柱状图"},"4963":{"id":"/docs/crest/user-guide/dashboard-143","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"分类维度 + 指标"},"4964":{"id":"/docs/crest/user-guide/dashboard-144","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"分类过多时做 Top N 或改用表格"},"4965":{"id":"/docs/crest/user-guide/dashboard-145","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"条形图"},"4966":{"id":"/docs/crest/user-guide/dashboard-146","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"分类维度 + 指标"},"4967":{"id":"/docs/crest/user-guide/dashboard-147","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"适合排名，分类名称较长时比柱状图更好读"},"4968":{"id":"/docs/crest/user-guide/dashboard-148","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"饼图"},"4969":{"id":"/docs/crest/user-guide/dashboard-149","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"分类维度 + 指标"},"4970":{"id":"/docs/crest/user-guide/dashboard-150","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"分类不要太多，超过 6 类建议改用条形图"},"4971":{"id":"/docs/crest/user-guide/dashboard-151","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"明细表"},"4972":{"id":"/docs/crest/user-guide/dashboard-152","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"多个维度和指标"},"4973":{"id":"/docs/crest/user-guide/dashboard-153","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"用于查明细，注意列宽、排序和分页"},"4974":{"id":"/docs/crest/user-guide/dashboard-154","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"双轴图"},"4975":{"id":"/docs/crest/user-guide/dashboard-155","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"1 个维度 + 2 个指标"},"4976":{"id":"/docs/crest/user-guide/dashboard-156","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"两个指标单位不同或量级差异大时使用"},"4977":{"id":"/docs/crest/user-guide/dashboard-157","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"字段配置完成后，至少做三项检查："},"4978":{"id":"/docs/crest/user-guide/dashboard-158","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"图表是否有数据。"},"4979":{"id":"/docs/crest/user-guide/dashboard-159","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"指标合计是否与数据集预览或业务样例一致。"},"4980":{"id":"/docs/crest/user-guide/dashboard-160","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#不同图表的字段配置","content":"排序、单位、小数位和空值显示是否符合业务习惯。"},"4981":{"id":"/docs/crest/user-guide/dashboard-161","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加查询组件","content":"查询组件用于让用户在页面上筛选数据，例如日期、区域、部门、产品、项目状态。它通常放在仪表盘顶部。"},"4982":{"id":"/docs/crest/user-guide/dashboard-162","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加查询组件","content":"查询组件不是图表，它的作用是控制其他图表。添加后要在右侧配置目标图表和筛选字段，否则它只是一个没有作用的控件。正式页面通常至少需要日期筛选，经营类页面还会增加区域、门店、产品或项目筛选。"},"4983":{"id":"/docs/crest/user-guide/dashboard-163","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加查询组件","content":"配置流程："},"4984":{"id":"/docs/crest/user-guide/dashboard-164","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#添加查询组件-1","content":"点击顶部“查询组件”，选择日期、下拉、文本搜索、数字区间等组件，放到页面顶部或筛选区。"},"4985":{"id":"/docs/crest/user-guide/dashboard-165","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#绑定目标图表","content":"选中查询组件，在右侧配置要影响哪些图表。一个筛选器可以影响一个或多个图表。"},"4986":{"id":"/docs/crest/user-guide/dashboard-166","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#选择筛选字段","content":"给每个目标图表选择对应字段。不同数据集之间字段名称可能不同，要确认业务含义一致。"},"4987":{"id":"/docs/crest/user-guide/dashboard-167","page_id":"/docs/crest/user-guide/dashboard","tags":[],"type":"text","url":"/docs/crest/user-guide/dashboard#设置展示方式","content":"日期字段使用日期或日期范围；区域、部门、产品使用下拉或搜索；金额、时长使用数字区间。"},"4988":{"id":"/docs/crest/user-guide/dashboard-168","page_id":"/docs/crest/user-guide/das