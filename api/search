："},"7793":{"id":"/docs/crest/deployment/service-management-13","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"关键字"},"7794":{"id":"/docs/crest/deployment/service-management-14","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"可能原因"},"7795":{"id":"/docs/crest/deployment/service-management-15","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"`Flyway`"},"7796":{"id":"/docs/crest/deployment/service-management-16","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"数据库迁移失败"},"7797":{"id":"/docs/crest/deployment/service-management-17","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"`Access denied`"},"7798":{"id":"/docs/crest/deployment/service-management-18","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"数据库账号或密码错误"},"7799":{"id":"/docs/crest/deployment/service-management-19","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"`Connection refused`"},"7800":{"id":"/docs/crest/deployment/service-management-20","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"数据库地址、端口或网络异常"},"7801":{"id":"/docs/crest/deployment/service-management-21","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"`OutOfMemory`"},"7802":{"id":"/docs/crest/deployment/service-management-22","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"内存不足"},"7803":{"id":"/docs/crest/deployment/service-management-23","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"`permission denied`"},"7804":{"id":"/docs/crest/deployment/service-management-24","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"目录权限异常"},"7805":{"id":"/docs/crest/deployment/service-management-25","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#查看日志","content":"日志排查建议按时间点进行。用户反馈“10:30 打不开仪表盘”时，优先查看 10:25 到 10:35 的日志，再结合审计日志和浏览器报错。不建议直接从最新日志向前翻查，容易遗漏关键异常。"},"7806":{"id":"/docs/crest/deployment/service-management-26","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#重启服务","content":"修改配置后通常需要重启："},"7807":{"id":"/docs/crest/deployment/service-management-27","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#重启服务","content":"重启后检查："},"7808":{"id":"/docs/crest/deployment/service-management-28","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#重启服务","content":"容器是否运行。"},"7809":{"id":"/docs/crest/deployment/service-management-29","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#重启服务","content":"登录页是否可访问。"},"7810":{"id":"/docs/crest/deployment/service-management-30","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#重启服务","content":"管理员是否能登录。"},"7811":{"id":"/docs/crest/deployment/service-management-31","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#重启服务","content":"工作台和系统设置是否正常打开。"},"7812":{"id":"/docs/crest/deployment/service-management-32","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#重启服务","content":"工作台能打开，说明前端资源、后端接口和基础元数据读取基本正常。继续打开数据源、数据集、仪表盘和导出中心，才能确认业务链路恢复。"},"7813":{"id":"/docs/crest/deployment/service-management-33","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#重启服务","content":"如果重启后页面能打开但图表空白，继续检查数据源连接、数据库连接池、后端日志和浏览器网络请求。服务重启成功只是第一步，不能证明业务链路已经完整恢复。"},"7814":{"id":"/docs/crest/deployment/service-management-34","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#备份和恢复","content":"备份文件可能包含数据库内容、上传文件、导出文件和业务配置，应按敏感数据管理。"},"7815":{"id":"/docs/crest/deployment/service-management-35","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#备份和恢复","content":"执行恢复前，应先确认恢复目标、备份时间和影响范围。恢复完成后，必须验证登录、权限、数据源、数据集、仪表盘、大屏、分享和导出，而不是只看命令执行成功。"},"7816":{"id":"/docs/crest/deployment/service-management-36","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#备份和恢复","content":"恢复后打开导出中心，确认历史任务状态和新导出任务都正常。导出文件涉及运行目录和文件权限，是恢复检查中容易遗漏的一环。"},"7817":{"id":"/docs/crest/deployment/service-management-37","page_id":"/docs/crest/deployment/service-management","tags":[],"type":"text","url":"/docs/crest/deployment/service-management#停机窗口","content":"升级、迁移数据库、恢复备份和调整密钥前，应安排停机窗口。停机窗口内建议禁止用户继续创建资源、导出文件或修改权限，避免状态不一致。"},"7818":{"id":"/docs/crest/deployment/single-node","page_id":"/docs/crest/deployment/single-node","type":"page","content":"单机在线安装","breadcrumbs":["技术文档","Crest","安装部署"],"tags"